# Copy this file to .env and fill in your values.
# The application reads these at startup via process.env.
# Never commit .env to version control.

# Public-facing base URL of the backend API
API_BASE_URL=https://api.event.com

# API version prefix (e.g. v1 → /v1/tickets/verify/:id)
API_VERSION=v1

# Marketing landing page — all Stand QR codes point here
MARKETING_URL=https://event.com/register

# Directory where generated QR code image files are saved
OUTPUT_DIR=./output
