# Copy this file to .env and fill in your values.
# Never commit .env to version control — it contains secrets.

# ── App Mode ───────────────────────────────────────────────────────────────────
# 'demo'       → emails go to Mailtrap sandbox (safe, never reaches real inboxes)
# 'production' → emails go to real recipients via live SMTP
APP_MODE=demo

# ── API Configuration ──────────────────────────────────────────────────────────
API_BASE_URL=https://api.event.com
API_VERSION=v1
PORT=3001

# Marketing landing page (what the Stand QR code points to)
MARKETING_URL=https://event.com/register

# Comma-separated list of allowed frontend origins (CORS)
ALLOWED_ORIGINS=http://localhost:5173

# ── QR Code Output ─────────────────────────────────────────────────────────────
OUTPUT_DIR=./output

# ── Mailtrap Sandbox SMTP (DEMO mode) ─────────────────────────────────────────
#
# HOW TO GET THESE CREDENTIALS:
#   1. Sign up / log in at https://mailtrap.io (free tier is enough)
#   2. In the left sidebar: Email Testing → Inboxes
#   3. Click your inbox name (or create one)
#   4. Under "SMTP Settings", click "Show Credentials"
#   5. Copy the values below:
#
MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_USER=4a71f27b0cb5ad
MAILTRAP_SMTP_PASS=31352a6b825d58

# ── Mailtrap Live / Production API (PRODUCTION mode only) ─────────────────────
# Found at: Mailtrap → Account → API Tokens
# Only needed when APP_MODE=production
MAILTRAP_API_TOKEN=

# ── Email Sender Identity ──────────────────────────────────────────────────────
# In demo mode, any value works. In production, this domain must be verified.
EMAIL_FROM=tickets@gamesummit.dev
EMAIL_FROM_NAME=Game Summit 2026
